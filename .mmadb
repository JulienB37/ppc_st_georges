services:
  devbox:
    container_name: mmadb_${DEVBOX_NAME:-ping_svg_championat}
    image: "mmadb_ping_svg_championat:alpine"
    build:
      context: .
      dockerfile: ./.mmadb-build
      args:
        USERNAME: $USERNAME
        UID: $UID
    ports:
      - ${DEVBOX_PORT:-4200}:4200
    volumes:
      - .:/home/$USERNAME/app
      - $USER_HOST_HOME_PATH/.npmrc:$DOCKER_HOME_PATH/.npmrc
      - $USER_HOST_HOME_PATH/.gitconfig:$DOCKER_HOME_PATH/.gitconfig
    tty: true
    stdin_open: true
    network_mode: bridge
    env_file:
      - path: .env
        required: false
