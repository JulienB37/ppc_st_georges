FROM oven/bun:latest

ARG USERNAME="developer"
ARG UID=1000

EXPOSE 3000 4200
LABEL Author="Generated by mmadb"

# création user
RUN userdel -r bun || true \
  && useradd -m -u ${UID} -s /bin/bash ${USERNAME} \
  && echo "${USERNAME}:${USERNAME}" | chpasswd

# packages utiles
RUN apt-get update \
  && apt-get install -y \
    bash \
    awscli \
  && rm -rf /var/lib/apt/lists/*

WORKDIR "/home/${USERNAME}/app"
USER ${USERNAME}

CMD [ "/bin/bash" ]