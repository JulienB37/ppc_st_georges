FROM node:22-bookworm

# bun reste necessaire pour rejouer legacy/ (oracle de comparaison du rendu).
# On copie le binaire officiel plutot que `npm i -g bun` : npm 12 bloque les
# scripts d'installation, ce qui laisserait un shim non fonctionnel.
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun

ARG USERNAME="developer"
ARG UID=1000

EXPOSE 3000 4200
LABEL Author="Generated by mmadb"

# création user
RUN userdel -r node || true \
  && useradd -m -u ${UID} -s /bin/bash ${USERNAME} \
  && echo "${USERNAME}:${USERNAME}" | chpasswd

# packages utiles
RUN apt-get update \
  && apt-get install -y \
    bash \
    git \
    awscli \
  && rm -rf /var/lib/apt/lists/*

# npm 10.9.x (livre avec node 22) plante sur la resolution des peer deps de vitest :
# "Cannot read properties of null (reading 'edgesOut')" dans arborist. npm 12 corrige.
RUN npm install -g npm@latest

WORKDIR "/home/${USERNAME}/app"
USER ${USERNAME}

CMD [ "/bin/bash" ]
