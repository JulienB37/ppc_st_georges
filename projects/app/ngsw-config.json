{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "coquille",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/favicon.ico", "/*.css", "/*.js"]
      }
    },
    {
      "name": "moteur",
      "installMode": "prefetch",
      "resources": {
        "files": ["/assets/fonts/**", "/assets/resvg/**", "/assets/fond/**", "/media/**"]
      }
    },
    {
      "name": "logos",
      "installMode": "prefetch",
      "resources": {
        "files": ["/assets/clubs/**", "/assets/sponsors/**"]
      }
    },
    {
      "name": "icones",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/icones/**"]
      }
    }
  ]
}
