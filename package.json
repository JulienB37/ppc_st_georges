{
  "name": "ppc-affiches",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app --host 0.0.0.0",
    "build": "ng build app",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:fonts": "node tools/build-fonts.mjs",
    "assets:build": "node --experimental-strip-types tools/build-assets.mts",
    "assets:vs": "esbuild tools/build-vs.mts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/vs.mjs --log-level=warning && node .tmp/vs.mjs",
    "assets:anneau": "esbuild tools/build-anneau.mts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/anneau.mjs --log-level=warning && node .tmp/anneau.mjs",
    "assets:pinceau": "esbuild tools/build-pinceau.mts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/pinceau.mjs --log-level=warning && node .tmp/pinceau.mjs",
    "assets:verify": "node --experimental-strip-types tools/verify-assets.mts",
    "render": "esbuild tools/render.mts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/render.mjs --log-level=warning && node .tmp/render.mjs",
    "spike:rendu": "node tools/spikes/resvg-fontkit.mjs",
    "spike:filtres": "node tools/spikes/resvg-filtres.mjs",
    "render:legacy": "cd legacy && bun run index.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "fontkit": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.5.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
